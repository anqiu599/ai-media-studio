# ============================================================
# DeepSeek API (必填 - 唯一必需)
# 注册获取: https://platform.deepseek.com/api_keys
# 费用: 约 ¥1/百万token
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ============================================================
# 视觉模型（可选 - 不填则使用 OpenCV 计算机视觉分析）
# OpenCV 分析是免费的，包含亮度/色彩/对比度/清晰度/人脸/场景复杂度等
# 如果你希望 AI 能理解具体画面内容，可以选配以下之一：
# ============================================================

# 方案A：本地 Ollama（免费，需8GB+显存）
# 安装: https://ollama.com 然后运行 ollama pull qwen2.5-vl:7b
# VISION_PROVIDER=ollama
# VISION_BASE_URL=http://localhost:11434/v1
# VISION_MODEL=qwen2.5-vl:7b
# VISION_API_KEY=ollama

# 方案B：OpenAI GPT-4o mini（付费，质量好）
# VISION_PROVIDER=openai
# VISION_API_KEY=sk-your-openai-key
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
